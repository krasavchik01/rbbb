&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресAPI = Константы.HUB_АдресAPI.Получить();
	Если ПустаяСтрока(СокрЛП(АдресAPI)) Тогда
		АдресAPI = "https://hub.rbpartners.kz/api/1c/sync";
	КонецЕсли;
	КлючAPI = Константы.HUB_КлючAPI.Получить();
	ДатаНачалаОбмена = Константы.HUB_ДатаНачалаОбмена.Получить();
	Если Не ЗначениеЗаполнено(ДатаНачалаОбмена) Тогда
		ДатаНачалаОбмена = НачалоДня(ДобавитьМесяц(ТекущаяДата(), -12));
	КонецЕсли;
	ОбменВключен = Константы.HUB_ОбменВключен.Получить();
	Статус = ?(ПустаяСтрока(СокрЛП(КлючAPI)), "Ключ HUB ещё не указан", "Настройки заполнены. Нажмите «Проверить связь».");

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере(НастроитьРегламентноеЗадание = Истина)

	АдресAPI = СокрЛП(АдресAPI);
	КлючAPI = СокрЛП(КлючAPI);
	Если ПустаяСтрока(АдресAPI) Тогда
		ВызватьИсключение "Укажите адрес API HUB.";
	КонецЕсли;
	Если ПустаяСтрока(КлючAPI) Тогда
		ВызватьИсключение "Укажите секретный ключ HUB.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаНачалаОбмена) Тогда
		ВызватьИсключение "Укажите дату начала обмена.";
	КонецЕсли;

	Константы.HUB_АдресAPI.Установить(АдресAPI);
	Константы.HUB_КлючAPI.Установить(КлючAPI);
	Константы.HUB_ДатаНачалаОбмена.Установить(НачалоДня(ДатаНачалаОбмена));
	Константы.HUB_ОбменВключен.Установить(ОбменВключен);
	Если НастроитьРегламентноеЗадание Тогда
		HUB_НастроитьРегламентноеЗадание();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура HUB_НастроитьРегламентноеЗадание()

	МетаданныеЗадания = Метаданные.РегламентныеЗадания.HUB_РегламентныйОбмен;
	РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеЗадания);
	Если РегламентноеЗадание = Неопределено Тогда
		ВызватьИсключение "Не найдено регламентное задание обмена с HUB.";
	КонецЕсли;

	РегламентноеЗадание.Использование = ОбменВключен;
	ТекущееРасписание = РегламентноеЗадание.Расписание;
	НужноУстановитьРасписание = Ложь;
	Если ОбменВключен Тогда
		Если ТекущееРасписание = Неопределено Тогда
			НужноУстановитьРасписание = Истина;
		ИначеЕсли Не ЗначениеЗаполнено(ТекущееРасписание.ПериодПовтораДней) Тогда
			НужноУстановитьРасписание = Истина;
		КонецЕсли;
	КонецЕсли;
	Если НужноУстановитьРасписание Тогда
		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ВремяНачала = '00010101080000';
		Расписание.ВремяКонца = '00010101200000';
		Расписание.ПериодПовтораВТечениеДня = 14400;
		Расписание.ПериодПовтораДней = 1;
		РегламентноеЗадание.Расписание = Расписание;
	КонецЕсли;
	РегламентноеЗадание.Записать();

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	Попытка
		СохранитьНастройкиНаСервере();
		Статус = "Настройки сохранены.";
		Сообщить(Статус);
	Исключение
		Статус = "Не удалось сохранить: " + ОписаниеОшибки();
		Сообщить(Статус, СтатусСообщения.Важное);
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПроверитьСвязьНаСервере()

	СохранитьНастройкиНаСервере(Ложь);
	Возврат HUB_ОбменСервер.ПроверитьСвязь();

КонецФункции

&НаКлиенте
Процедура ПроверитьСвязь(Команда)

	Статус = "Проверяем связь с HUB...";
	Попытка
		ОтветHUB = ПроверитьСвязьНаСервере();
		Статус = "Связь с HUB установлена успешно.";
		Сообщить(Статус);
	Исключение
		Статус = "Ошибка подключения к HUB: " + ОписаниеОшибки();
		Сообщить(Статус, СтатусСообщения.Важное);
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ЗапуститьОбменСейчасНаСервере()

	СохранитьНастройкиНаСервере();
	Возврат HUB_ОбменСервер.ВыполнитьОбменСейчас();

КонецФункции

&НаКлиенте
Процедура ЗапуститьОбменСейчас(Команда)

	Статус = "Загружаем бухгалтерские документы в HUB...";
	Попытка
		КоличествоЗаписей = ЗапуститьОбменСейчасНаСервере();
		Статус = СтрШаблон("Обмен завершен успешно. Передано записей: %1.", КоличествоЗаписей);
		Сообщить(Статус);
	Исключение
		Статус = "Ошибка обмена с HUB: " + ОписаниеОшибки();
		Сообщить(Статус, СтатусСообщения.Важное);
	КонецПопытки;

КонецПроцедуры
