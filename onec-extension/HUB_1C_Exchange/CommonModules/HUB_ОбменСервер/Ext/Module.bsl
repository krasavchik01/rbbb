// Обмен бухгалтерских документов с HUB.
// Конфигурация: Бухгалтерия для Казахстана 3.0.73.1.
// Расширение только читает проведенные документы 1С и выполняет исходящий HTTPS-запрос.

Функция ПроверитьСвязь() Экспорт
	
	Пакет = Новый Структура;
	Пакет.Вставить("source", "1С Бухгалтерия для Казахстана 3.0.73.1 / MAK_290424");
	Пакет.Вставить("fullSnapshot", Ложь);
	Пакет.Вставить("records", Новый Массив);
	
	Возврат HUB_ОтправитьПакет(Пакет);
	
КонецФункции

Процедура ВыполнитьОбмен() Экспорт
	
	Если Не Константы.HUB_ОбменВключен.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	HUB_ВыполнитьОбмен();
	
КонецПроцедуры

Функция ВыполнитьОбменСейчас() Экспорт
	
	Возврат HUB_ВыполнитьОбмен();
	
КонецФункции

Функция HUB_ВыполнитьОбмен()
	
	HUB_ПроверитьНастройки();
	ДатаНачала = HUB_ДатаНачалаОбмена();
	Записи = Новый Массив;
	
	HUB_ДобавитьСчета(Записи, ДатаНачала);
	HUB_ДобавитьАВР(Записи, ДатаНачала);
	HUB_ДобавитьЭСФ(Записи, ДатаНачала);
	HUB_ДобавитьОплаты(Записи, ДатаНачала);
	
	HUB_ОтправитьЗаписиПакетами(Записи, 250);
	
	ЗаписьЖурналаРегистрации(
		"HUB.Обмен1С",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон("Обмен с HUB завершен. Подготовлено записей: %1", Записи.Количество()));
	
	Возврат Записи.Количество();
	
КонецФункции

Функция ПолучитьСтатусНастроек() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Адрес", СокрЛП(Константы.HUB_АдресAPI.Получить()));
	Результат.Вставить("КлючЗадан", Не ПустаяСтрока(СокрЛП(Константы.HUB_КлючAPI.Получить())));
	Результат.Вставить("ОбменВключен", Константы.HUB_ОбменВключен.Получить());
	Результат.Вставить("ДатаНачала", Константы.HUB_ДатаНачалаОбмена.Получить());
	Возврат Результат;
	
КонецФункции

Процедура HUB_ПроверитьНастройки()
	
	Если ПустаяСтрока(СокрЛП(Константы.HUB_АдресAPI.Получить())) Тогда
		ВызватьИсключение "Не указан адрес API HUB.";
	КонецЕсли;
	
	Если ПустаяСтрока(СокрЛП(Константы.HUB_КлючAPI.Получить())) Тогда
		ВызватьИсключение "Не указан ключ API HUB.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Константы.HUB_ДатаНачалаОбмена.Получить()) Тогда
		ВызватьИсключение "Не указана дата начала обмена с HUB.";
	КонецЕсли;
	
КонецПроцедуры

Функция HUB_ДатаНачалаОбмена()
	
	ДатаНачала = Константы.HUB_ДатаНачалаОбмена.Получить();
	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		Возврат НачалоДня(ДобавитьМесяц(ТекущаяДата(), -12));
	КонецЕсли;
	Возврат НачалоДня(ДатаНачала);
	
КонецФункции

Процедура HUB_ДобавитьСчета(Записи, ДатаНачала)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Счет.Ссылка КАК Ссылка,
	| Счет.Номер КАК Номер,
	| Счет.Дата КАК Дата,
	| Счет.Проведен КАК Проведен,
	| Счет.СуммаДокумента КАК Сумма,
	| ЕСТЬNULL(Счет.ВалютаДокумента.БуквенныйКод, """") КАК Валюта,
	| ЕСТЬNULL(Счет.Организация.Наименование, """") КАК Организация,
	| ЕСТЬNULL(Счет.Организация.ИдентификационныйНомер, """") КАК БИНОрганизации,
	| ЕСТЬNULL(Счет.Контрагент.Наименование, """") КАК Контрагент,
	| ЕСТЬNULL(Счет.Контрагент.ИдентификационныйКодЛичности, """") КАК БИНКонтрагента,
	| ЕСТЬNULL(Счет.ДоговорКонтрагента.НомерДоговора, """") КАК НомерДоговора,
	| ЕСТЬNULL(Счет.ДоговорКонтрагента.УстановленСрокОплаты, ЛОЖЬ) КАК УстановленСрокОплаты,
	| ЕСТЬNULL(Счет.ДоговорКонтрагента.СрокОплаты, 0) КАК СрокОплаты,
	| ЕСТЬNULL(Счет.Комментарий, """") КАК Комментарий
	|ИЗ
	| Документ.СчетНаОплатуПокупателю КАК Счет
	|ГДЕ
	| Счет.Дата >= &ДатаНачала
	| И НЕ Счет.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СрокОплаты = Неопределено;
		Если Выборка.УстановленСрокОплаты И Выборка.СрокОплаты > 0 Тогда
			СрокОплаты = Выборка.Дата + Выборка.СрокОплаты * 86400;
		КонецЕсли;
		
		Запись = HUB_ОсновнаяЗапись("invoice", Выборка);
		Запись.Вставить("dueDate", HUB_ДатаJSON(СрокОплаты));
		Запись.Вставить("status", ?(Выборка.Проведен, "issued", "draft"));
		Запись.Вставить("notes", HUB_БезопаснаяСтрока(Выборка.Комментарий));
		Записи.Добавить(Запись);
	КонецЦикла;
	
КонецПроцедуры

Процедура HUB_ДобавитьАВР(Записи, ДатаНачала)
	
	ЭлектронныеАкты = HUB_КартаЭлектронныхАВР(ДатаНачала);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Реализация.Ссылка КАК Ссылка,
	| Реализация.Номер КАК Номер,
	| Реализация.Дата КАК Дата,
	| Реализация.Проведен КАК Проведен,
	| Реализация.СуммаДокумента КАК Сумма,
	| ЕСТЬNULL(Реализация.ВалютаДокумента.БуквенныйКод, """") КАК Валюта,
	| ЕСТЬNULL(Реализация.Организация.Наименование, """") КАК Организация,
	| ЕСТЬNULL(Реализация.Организация.ИдентификационныйНомер, """") КАК БИНОрганизации,
	| ЕСТЬNULL(Реализация.Контрагент.Наименование, """") КАК Контрагент,
	| ЕСТЬNULL(Реализация.Контрагент.ИдентификационныйКодЛичности, """") КАК БИНКонтрагента,
	| ЕСТЬNULL(Реализация.ДоговорКонтрагента.НомерДоговора, """") КАК НомерДоговора,
	| ЕСТЬNULL(Реализация.Комментарий, """") КАК Комментарий
	|ИЗ
	| Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	| Реализация.Дата >= &ДатаНачала
	| И НЕ Реализация.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = HUB_ОсновнаяЗапись("avr", Выборка);
		Статус = ?(Выборка.Проведен, "issued", "draft");
		Примечание = HUB_БезопаснаяСтрока(Выборка.Комментарий);
		КлючОснования = XMLСтрока(Выборка.Ссылка);
		ДанныеАкта = ЭлектронныеАкты.Получить(КлючОснования);
		Если ДанныеАкта <> Неопределено Тогда
			Статус = ДанныеАкта.Статус;
			Если Не ПустаяСтрока(ДанныеАкта.Номер) Тогда
				Запись.Вставить("number", ДанныеАкта.Номер);
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеАкта.Дата) Тогда
				Запись.Вставить("date", HUB_ДатаJSON(ДанныеАкта.Дата));
			КонецЕсли;
			Примечание = СтрШаблон("ЭАВР %1. %2", ДанныеАкта.Номер, Примечание);
		КонецЕсли;
		Запись.Вставить("status", Статус);
		Запись.Вставить("notes", HUB_БезопаснаяСтрока(Примечание));
		Записи.Добавить(Запись);
	КонецЦикла;
	
КонецПроцедуры

Функция HUB_КартаЭлектронныхАВР(ДатаНачала)
	
	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Акт.ДокументОснование КАК ДокументОснование,
	| Акт.ДатаВыполненияРабот КАК Дата,
	| Акт.РегистрационныйНомер КАК РегистрационныйНомер,
	| Акт.Номер КАК Номер,
	| Акт.Статус КАК Статус,
	| Акт.Состояние КАК Состояние,
	| Акт.ДатаПодписиПолучателя КАК ДатаПодписиПолучателя
	|ИЗ
	| Документ.ЭлектронныйАктВыполненныхРабот КАК Акт
	|ГДЕ
	| Акт.Дата >= &ДатаНачала
	| И НЕ Акт.ПометкаУдаления
	| И Акт.Направление = ЗНАЧЕНИЕ(Перечисление.НаправленияЭСФ.Исходящий)
	|УПОРЯДОЧИТЬ ПО
	| Акт.Дата";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.ДокументОснование) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ДатаПодписиПолучателя)
			Или Выборка.Статус = Перечисления.СтатусыАВР.Подтвержденный
			Или Выборка.Состояние = Перечисления.СостоянияАВР.ПодтвержденПолучателем Тогда
			СтатусHUB = "signed";
		ИначеЕсли Не ПустаяСтрока(HUB_БезопаснаяСтрока(Выборка.РегистрационныйНомер)) Тогда
			СтатусHUB = "sent";
		Иначе
			СтатусHUB = "issued";
		КонецЕсли;
		НомерАкта = HUB_БезопаснаяСтрока(Выборка.РегистрационныйНомер);
		Если ПустаяСтрока(НомерАкта) Тогда
			НомерАкта = HUB_БезопаснаяСтрока(Выборка.Номер);
		КонецЕсли;
		ДанныеАкта = Новый Структура("Статус,Номер,Дата", СтатусHUB, НомерАкта, Выборка.Дата);
		Результат.Вставить(XMLСтрока(Выборка.ДокументОснование), ДанныеАкта);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура HUB_ДобавитьЭСФ(Записи, ДатаНачала)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| ЭСФ.Ссылка КАК Ссылка,
	| ЭСФ.Номер КАК Номер,
	| ЭСФ.Дата КАК Дата,
	| ЭСФ.Проведен КАК Проведен,
	| ЭСФ.СуммаДокумента КАК Сумма,
	| ЕСТЬNULL(ЭСФ.ВалютаКод, """") КАК Валюта,
	| ЕСТЬNULL(ЭСФ.Организация.Наименование, """") КАК Организация,
	| ЕСТЬNULL(ЭСФ.Организация.ИдентификационныйНомер, """") КАК БИНОрганизации,
	| ЕСТЬNULL(ЭСФ.Контрагент.Наименование, """") КАК Контрагент,
	| ЕСТЬNULL(ЭСФ.Контрагент.ИдентификационныйКодЛичности, """") КАК БИНКонтрагента,
	| ЕСТЬNULL(ЭСФ.ДоговорПоставкиНомер, """") КАК НомерДоговора,
	| ЕСТЬNULL(ЭСФ.РегистрационныйНомер, """") КАК РегистрационныйНомер,
	| ЭСФ.Направление КАК Направление,
	| ЭСФ.Статус КАК Статус,
	| ЭСФ.Состояние КАК Состояние,
	| ЕСТЬNULL(ЭСФ.Комментарий, """") КАК Комментарий
	|ИЗ
	| Документ.ЭСФ КАК ЭСФ
	|ГДЕ
	| ЭСФ.Дата >= &ДатаНачала
	| И НЕ ЭСФ.ПометкаУдаления
	| И ЭСФ.Направление = ЗНАЧЕНИЕ(Перечисление.НаправленияЭСФ.Исходящий)";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = HUB_ОсновнаяЗапись("esf", Выборка);
		Если Не ПустаяСтрока(HUB_БезопаснаяСтрока(Выборка.РегистрационныйНомер)) Тогда
			Запись.Вставить("number", HUB_БезопаснаяСтрока(Выборка.РегистрационныйНомер));
			СтатусHUB = "registered";
		ИначеЕсли Выборка.Проведен Тогда
			СтатусHUB = "sent";
		Иначе
			СтатусHUB = "draft";
		КонецЕсли;
		Запись.Вставить("status", СтатусHUB);
		Запись.Вставить("notes", HUB_БезопаснаяСтрока(Выборка.Комментарий));
		Записи.Добавить(Запись);
	КонецЦикла;
	
КонецПроцедуры

Процедура HUB_ДобавитьОплаты(Записи, ДатаНачала)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Платеж.Ссылка КАК Ссылка,
	| Платеж.Номер КАК Номер,
	| Платеж.Дата КАК Дата,
	| Платеж.Проведен КАК Проведен,
	| ЕСТЬNULL(Расшифровка.СуммаПлатежа, Платеж.СуммаДокумента) КАК Сумма,
	| ЕСТЬNULL(Платеж.ВалютаДокумента.БуквенныйКод, """") КАК Валюта,
	| ЕСТЬNULL(Платеж.Организация.Наименование, """") КАК Организация,
	| ЕСТЬNULL(Платеж.Организация.ИдентификационныйНомер, """") КАК БИНОрганизации,
	| ЕСТЬNULL(Платеж.Контрагент.Наименование, """") КАК Контрагент,
	| ЕСТЬNULL(Платеж.Контрагент.ИдентификационныйКодЛичности, """") КАК БИНКонтрагента,
	| ЕСТЬNULL(Расшифровка.ДоговорКонтрагента.НомерДоговора, """") КАК НомерДоговора,
	| ЕСТЬNULL(Расшифровка.НомерСтроки, 0) КАК НомерСтроки,
	| ЕСТЬNULL(Платеж.НазначениеПлатежа, """") КАК НазначениеПлатежа,
	| Платеж.Оплачено КАК Оплачено
	|ИЗ
	| Документ.ПлатежноеПоручениеВходящее КАК Платеж
	| 	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежноеПоручениеВходящее.РасшифровкаПлатежа КАК Расшифровка
	| 	ПО Платеж.Ссылка = Расшифровка.Ссылка
	|ГДЕ
	| Платеж.Дата >= &ДатаНачала
	| И НЕ Платеж.ПометкаУдаления
	| И Платеж.Проведен";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = HUB_ОсновнаяЗапись("payment", Выборка);
		Запись.Вставить(
			"externalId",
			СтрШаблон("%1-%2", Выборка.Ссылка.УникальныйИдентификатор(), Выборка.НомерСтроки));
		Запись.Вставить("paymentKind", "other");
		Запись.Вставить("reference", HUB_БезопаснаяСтрока(Выборка.НазначениеПлатежа));
		Записи.Добавить(Запись);
	КонецЦикла;
	
КонецПроцедуры

Функция HUB_ОсновнаяЗапись(Вид, Выборка)
	
	Запись = Новый Структура;
	Запись.Вставить("kind", Вид);
	Запись.Вставить("externalId", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	Запись.Вставить("number", HUB_БезопаснаяСтрока(Выборка.Номер));
	Запись.Вставить("date", HUB_ДатаJSON(Выборка.Дата));
	Запись.Вставить("amount", Выборка.Сумма);
	Валюта = HUB_БезопаснаяСтрока(Выборка.Валюта);
	Запись.Вставить("currency", ?(ПустаяСтрока(Валюта), "KZT", Валюта));
	Запись.Вставить("contractNumber", HUB_БезопаснаяСтрока(Выборка.НомерДоговора));
	Запись.Вставить("organizationBin", HUB_ТолькоЦифры(Выборка.БИНОрганизации));
	Запись.Вставить("organizationName", HUB_БезопаснаяСтрока(Выборка.Организация));
	Запись.Вставить("counterpartyBin", HUB_ТолькоЦифры(Выборка.БИНКонтрагента));
	Запись.Вставить("counterpartyName", HUB_БезопаснаяСтрока(Выборка.Контрагент));
	Запись.Вставить("updatedAt", HUB_ДатаВремяJSON(ТекущаяДата()));
	Возврат Запись;
	
КонецФункции

Процедура HUB_ОтправитьЗаписиПакетами(Записи, РазмерПакета)
	
	Если Записи.Количество() = 0 Тогда
		HUB_ОтправитьПакет(HUB_НовыйПакет(Новый Массив));
		Возврат;
	КонецЕсли;
	
	ТекущийПакет = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		ТекущийПакет.Добавить(Запись);
		Если ТекущийПакет.Количество() >= РазмерПакета Тогда
			HUB_ОтправитьПакет(HUB_НовыйПакет(ТекущийПакет));
			ТекущийПакет = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	
	Если ТекущийПакет.Количество() > 0 Тогда
		HUB_ОтправитьПакет(HUB_НовыйПакет(ТекущийПакет));
	КонецЕсли;
	
КонецПроцедуры

Функция HUB_НовыйПакет(Записи)
	
	Пакет = Новый Структура;
	Пакет.Вставить("source", "1С Бухгалтерия для Казахстана 3.0.73.1 / MAK_290424");
	Пакет.Вставить("fullSnapshot", Ложь);
	Пакет.Вставить("records", Записи);
	Возврат Пакет;
	
КонецФункции

Функция HUB_ОтправитьПакет(Пакет)
	
	Адрес = СокрЛП(Константы.HUB_АдресAPI.Получить());
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "https://hub.rbpartners.kz/api/1c/sync";
	КонецЕсли;
	Ключ = СокрЛП(Константы.HUB_КлючAPI.Получить());
	Если ПустаяСтрока(Ключ) Тогда
		ВызватьИсключение "Не указан ключ API HUB.";
	КонецЕсли;
	
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Адрес);
	ЗащищенноеСоединение = Неопределено;
	Если НРег(СтруктураURI.Схема) = "https" Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение(
			,
			Новый СертификатыУдостоверяющихЦентровОС);
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение(
		СтруктураURI.Хост,
		СтруктураURI.Порт,
		,
		,
		ПолучениеФайловИзИнтернета.ПолучитьПрокси(СтруктураURI.Схема),
		60,
		ЗащищенноеСоединение);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("X-Hub-1C-Key", Ключ);
	HTTPЗапрос = Новый HTTPЗапрос(СтруктураURI.ПутьНаСервере, Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(
		HUB_СтрокаJSON(Пакет),
		КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	
	HTTPОтвет = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
	ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон(
			"HUB вернул ошибку HTTP %1: %2",
			HTTPОтвет.КодСостояния,
			ТелоОтвета);
	КонецЕсли;
	Возврат ТелоОтвета;
	
КонецФункции

Функция HUB_СтрокаJSON(Значение)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция HUB_ДатаJSON(Значение)
	
	Если Значение = Неопределено Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Значение, "ДФ=yyyy-MM-dd");
	
КонецФункции

Функция HUB_ДатаВремяJSON(Значение)
	
	Возврат Формат(Значение, "ДФ=yyyy-MM-dd'T'HH:mm:ss");
	
КонецФункции

Функция HUB_ТолькоЦифры(Значение)
	
	Результат = "";
	СтрокаЗначения = HUB_БезопаснаяСтрока(Значение);
	Для Позиция = 1 По СтрДлина(СтрокаЗначения) Цикл
		Символ = Сред(СтрокаЗначения, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция HUB_БезопаснаяСтрока(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции
