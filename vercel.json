{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/1c/sync.mjs": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/|seafile-proxy/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/deadline-reminders",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/seafile-proxy/(.*)",
      "destination": "https://cloud.rbpartners.kz/$1"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|favicon\\.ico|apple-touch-icon\\.png|manifest\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
